# PaRo environment (copy to .env — never commit .env)

# --- Database ---
DATABASE_URL=postgresql+psycopg://paro:paro@localhost:5432/paro

# --- Redis (Phase 6 worker queue) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
# Constant single-user id for per-user tables (v1: no auth)
DEFAULT_USER_ID=1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TZ=Asia/Kolkata

# --- Azure AI Foundry (chat + embeddings + vision-OCR) ---
AZURE_FOUNDRY_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-08-01-preview
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-4o
AZURE_FOUNDRY_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
AZURE_FOUNDRY_VISION_DEPLOYMENT=gpt-4o

# --- Object storage (book PDFs + page images; local fallback if unset) ---
# Use local filesystem when STORAGE_BACKEND=local
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
# Azure Blob (optional)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=paro-books
# S3-compatible (optional)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=paro-books
S3_REGION=us-east-1

# --- Price sync ---
# yfinance | mock  (use mock offline / until Yahoo is reachable)
PRICE_PROVIDER=mock
SYNC_CRON_HOUR_IST=16
SYNC_CRON_MINUTE_IST=30
